# Base de données (SQLite en local ; passer à PostgreSQL en production, voir README)
DATABASE_URL="file:./dev.db"

# Secret de session (32+ caractères aléatoires)
AUTH_SECRET="change-me-to-a-long-random-string"

# URL publique de l'app (OAuth TikTok/Instagram, liens)
APP_URL="http://localhost:3000"

# Claude — scripts, hooks, slideshows. Sans clé : générateur de démo hors-ligne.
ANTHROPIC_API_KEY=""

# Fournisseur vidéo avatar (yapper). "mock" = rendu de démo, "heygen" = HeyGen API v2.
VIDEO_PROVIDER="mock"
HEYGEN_API_KEY=""

# Publication. "mock" = publication simulée ; "live" = API officielles.
PUBLISH_MODE="mock"
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
META_APP_ID=""
META_APP_SECRET=""

# Protège /api/cron/* (en-tête Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="change-me"
